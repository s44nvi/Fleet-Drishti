# Copy this file to .env and fill in real values. Never commit .env.

# Used by app/config.py (Settings.database_url) via SQLAlchemy.
DATABASE_URL=postgresql://username:password@localhost:5432/citylens_db

# Used by app/config.py (Settings.env). One of: development, staging, production.
ENV=development

# Used by app/services/auth_service.py to sign/verify JWT access tokens.
# Falls back to an insecure dev default if unset - always set a real
# secret outside of local development.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
